{
    "version": 2,
    "installCommand": "npm install",
    "builds": [
        {
            "src": "backend/src/index.js",
            "use": "@vercel/node"
        },
        {
            "src": "frontend/package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "dist",
                "installCommand": "npm install",
                "buildCommand": "npm run build"
            }
        }
    ],
    "rewrites": [
        {
            "source": "/api/v1/(.*)",
            "destination": "/backend/src/index.js"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}